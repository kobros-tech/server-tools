<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Form View -->
    <record id="json_import_schema_form_view" model="ir.ui.view">
        <field name="name">json.import.schema.form</field>
        <field name="model">json.import.schema</field>
        <field name="arch" type="xml">
            <form string="JSON Import Schema">
                <header>
                    <button
                        name="action_open_import_wizard"
                        string="Import JSON File"
                        type="object"
                        class="oe_highlight"
                        icon="fa-upload"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_logs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                        >
                            <field name="log_count" widget="statinfo" string="Logs" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Schema Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Target Model">
                            <field name="active" invisible="1" />
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="model_name" invisible="1" />
                            <field
                                name="exporter_id"
                                context="{'form_view_ref': 'base_jsonify.view_ir_exports'}"
                                options="{'no_open': True}"
                            />
                            <field name="description" />
                        </group>
                        <group string="Import Mode">
                            <field name="import_mode" />
                            <field name="duplicate_detect_mode" />
                            <field
                                name="duplicate_field_id"
                                attrs="{'invisible': [('duplicate_detect_mode', '!=', 'field')], 'required': [('duplicate_detect_mode', '=', 'field')]}"
                                options="{'no_create': True}"
                            />
                            <field name="create_missing_related" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Expected JSON Schema" name="json_schema">
                            <div class="alert alert-info" role="alert">
                                Expected input JSON Schema (JSON Schema draft-07).
                                Submit data as <code>{"records": [...]}</code>,
                                a plain array <code>[...]</code>,
                                or a single object <code>{...}</code>.
                                Also available via the REST endpoint at
                                <code>/api/json_import/&lt;path&gt;/schema</code>
                            </div>
                            <field
                                name="json_schema"
                                widget="text"
                                readonly="1"
                                nolabel="1"
                                class="o_field_text"
                            />
                        </page>
                        <page
                            string="Endpoints"
                            name="endpoints"
                            attrs="{'invisible': [('id', '=', False)]}"
                        >
                            <field name="endpoint_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="name" />
                                    <field name="route_path" />
                                    <field name="full_url" widget="url" />
                                    <field name="schema_url" widget="url" />
                                    <field name="auth_type" />
                                    <field name="validate_schema" />
                                    <field name="active" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="json_import_schema_tree_view" model="ir.ui.view">
        <field name="name">json.import.schema.tree</field>
        <field name="model">json.import.schema</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="model_name" />
                <field name="exporter_id" />
                <field name="import_mode" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="json_import_schema_search_view" model="ir.ui.view">
        <field name="name">json.import.schema.search</field>
        <field name="model">json.import.schema</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="model_name" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_model"
                        string="Model"
                        context="{'group_by': 'model_name'}"
                    />
                    <filter
                        name="group_mode"
                        string="Import Mode"
                        context="{'group_by': 'import_mode'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="json_import_schema_action" model="ir.actions.act_window">
        <field name="name">Import Schemas</field>
        <field name="res_model">json.import.schema</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="json_import_schema_search_view" />
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
